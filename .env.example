# Copy to .env (git-ignored) and fill in. Generate secrets with:
#   openssl rand -base64 48
#
# Shared by jwt-provider (signs tokens) and cv-adapter (verifies them).
# HS256, used as raw UTF-8 bytes, must be at least 32 characters.
JWT_SECRET=
# Signs the admin UI session cookie.
SESSION_SECRET=

# Public URL of the candidate UI, used in password-recovery emails.
PUBLIC_URL=http://virtual-hr-app.discutie.link:8080/

# Optional SMTP for registration/recovery emails (left empty = emails fail, the rest works).
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Host port the gateway listens on (bound to 127.0.0.1 only).
GATEWAY_PORT=8088

# Image naming, used when building on the Mac and loading on the Pi.
IMAGE_PREFIX=virtualhr
TAG=latest

# JVM limits for the four Spring Boot services.
JAVA_TOOL_OPTIONS=-Xmx256m -Xss512k -XX:+UseSerialGC -XX:MaxMetaspaceSize=160m
