<div class="row m-3">
    <a href="<%= base %>/home"><i class="fas fa-arrow-left"></i></a>
</div>
<div class="row">
    <div class="col-4">
        <div class="card m-3" *ngIf="currentUser">
            <div class="card-header p-1">
                <h6 class="card-text text-center m-2">
                    <fa-icon [icon]="faUser"></fa-icon>
                    <%= currentUser.cv.email %>
                </h6>
            </div>
            <div class="card-body p-1">
                <div class="card-img-wrapper m-3 text-center">
                    <img src="<%= currentUser.cv.photoUrl %>" alt="<%= currentUser.cv.email %>"
                         class="img-fluid img-thumbnail card-img-top user-profile-picture">
                </div>
                <div class="ml-2">
                    <h6 class="card-title m-2">
                        <strong>First Name: </strong><%= currentUser.cv.firstname %>
                    </h6>
                    <h6 class="card-title m-2">
                        <strong>Last Name: </strong><%= currentUser.cv.lastname %>
                    </h6>
                    <h6 class="card-title m-2">
                        <strong>Contact Email: </strong><%= currentUser.cv.email %>
                    </h6>
                    <h6 class="card-title m-2">
                        <strong>Gender: </strong><%= currentUser.cv.gender %>
                    </h6>
                    <h6 class="card-title m-2">
                        <strong>Birthdate: </strong><%= currentUser.cv.birthdate %>
                    </h6>
                    <h6 class="card-title m-2">
                        <strong>Age: </strong><%= currentUser.cv.age %>
                    </h6>
                    <h6 *ngIf="currentUser.cv.motto" class="card-title m-2">
                        <strong>Motto: </strong><%= currentUser.cv.motto %>
                    </h6>
                </div>
            </div>
            <div *ngIf="currentUser.cv.aboutMe" class="card-footer p-1">
                <blockquote class="blockquote ml-4 mr-4">
                    <div class="card-text mb-0">"<%= currentUser.cv.aboutMe %>"</div>
                </blockquote>
            </div>
        </div>
    </div>

    <div class="col-8">
        <table class="table table-striped text-center m-3 small custom_small">
            <thead>
            <tr>
                <th class="align-middle" scope="col">User Role
                    <%if (currentUser.rolesStr.includes('user')){%>
                        <i class="fas fa-check text-success"></i>
                    <%} else {%>
                        <i class="fas fa-times text-danger"></i>
                    <%}%>
                </th>
                <th class="align-middle" scope="col">Manager Role
                    <%if (currentUser.rolesStr.includes('manager')){%>
                        <i class="fas fa-check text-success"></i>
                    <%} else {%>
                        <i class="fas fa-times text-danger"></i>
                    <%}%>
                </th>
                <th class="align-middle" scope="col">Admin Role
                    <%if (currentUser.rolesStr.includes('admin')){%>
                        <i class="fas fa-check text-success"></i>
                    <%} else {%>
                        <i class="fas fa-times text-danger"></i>
                    <%}%>
                </th>
                <th class="align-middle" scope="col">Access To The Test
                    <%if (currentUser.cv.canTakeTheIqRequest){%>
                        <i class="fas fa-check text-success"></i>
                    <%} else {%>
                        <i class="fas fa-times text-danger"></i>
                    <%}%>
                </th>
            </tr>
            </thead>
            <tbody>
            <tr>
                <td class="align-middle"><button id='grant_user_role' value="<%=currentUser.uid%>" class="btn btn-info custom_button <%=(currentUser.rolesStr.includes('user'))? 'disabled': ''%>">Grant</button></td>
                <td class="align-middle"><button id='grant_manager_role' value="<%=currentUser.uid%>" class="btn btn-info custom_button <%=(currentUser.rolesStr.includes('manager'))? 'disabled': ''%>">Grant</button></td>
                <td class="align-middle"><button id='grant_admin_role' value="<%=currentUser.uid%>" class="btn btn-info custom_button <%=(currentUser.rolesStr.includes('admin'))? 'disabled': ''%>">Grant</button></td>
                <td class="align-middle"><button id='grant_access_role' value="<%=currentUser.uid%>" class="btn btn-info custom_button <%=(currentUser.cv.canTakeTheIqRequest)? 'disabled': ''%>">Grant</button></td>
            </tr>
            <tr>
                <td class="align-middle"><button id='revoke_user_role' value="<%=currentUser.uid%>" class="btn btn-danger custom_button <%=(!currentUser.rolesStr.includes('user'))? 'disabled': ''%>">Revoke</button></td>
                <td class="align-middle"><button id='revoke_manager_role' value="<%=currentUser.uid%>" class="btn btn-danger custom_button <%=(!currentUser.rolesStr.includes('manager'))? 'disabled': ''%>">Revoke</button></td>
                <td class="align-middle"><button id='revoke_admin_role' value="<%=currentUser.uid%>" class="btn btn-danger custom_button <%=(!currentUser.rolesStr.includes('admin'))? 'disabled': ''%>">Revoke</button></td>
                <td class="align-middle"><button id='revoke_access_role' value="<%=currentUser.uid%>" class="btn btn-danger custom_button <%=(!currentUser.cv.canTakeTheIqRequest)? 'disabled': ''%>">Revoke</button></td>
            </tr>
            </tbody>
        </table>
    </div>
</div>
