<div class="row">
<div class="col-8">
    <table class="table table-striped text-center m-3 small custom_small">
        <thead>
        <tr>
          <th class="align-middle" scope="col">UID</th>
          <th class="align-middle" scope="col">Email</th>
          <th class="align-middle" scope="col">Roles</th>
          <th class="align-middle" scope="col">User Role</th>
          <th class="align-middle" scope="col">Manager Role</th>
          <th class="align-middle" scope="col">Admin Role</th>
          <th class="align-middle" scope="col">Can Take The Test</th>
          <th class="align-middle" scope="col">Requested The Retake Of The Test</th>
          <th class="align-middle" scope="col">Actions</th>
        </tr>
        </thead>
        <tbody>
        <%
            for (let i = 0; i < users.length; i++){%>
                <tr *ngFor="let award of awards; index as i">
                  <td class="align-middle"><%=users[i].uid%></td>
                  <td class="align-middle"><%=users[i].email%></td>
                  <td class="align-middle"><%=users[i].rolesStr%></td>
                  <td class="align-middle">
                        <%if (users[i].rolesStr.includes('user')){%>
                            <i class="fas fa-check text-success"></i>
                        <%} else {%>
                            <i class="fas fa-times text-danger"></i>
                        <%}%>
                    </td>
                <td class="align-middle">
                      <%if (users[i].rolesStr.includes('manager')){%>
                          <i class="fas fa-check text-success"></i>
                      <%} else {%>
                          <i class="fas fa-times text-danger"></i>
                      <%}%>
                  </td>
                  <td class="align-middle">
                      <%if (users[i].rolesStr.includes('admin')){%>
                          <i class="fas fa-check text-success"></i>
                      <%} else {%>
                          <i class="fas fa-times text-danger"></i>
                      <%}%>
                  </td>
                  <td class="align-middle">
                      <%if (users[i].cv.canTakeTheIqRequest){%>
                          <i class="fas fa-check text-success"></i>
                      <%} else {%>
                          <i class="fas fa-times text-danger"></i>
                      <%}%>
                  </td>
                  <td class="align-middle">
                      <%if (users[i].cv.requestedRetakeOfIqTest){%>
                          <i class="fas fa-check text-success"></i>
                      <%} else {%>
                          <i class="fas fa-times text-danger"></i>
                      <%}%>
                  </td>
                  <td class="align-middle">
                   <a href="users/<%=users[i].uid%>"><i class="fas fa-edit"></i></a>
                </td>
                </tr>
        <%}%>
        </tbody>
      </table>
    </div>
    <div class="col-4">
        <div class="card m-3" *ngIf="currentUser">
          <div class="card-header p-1">
            <h6 class="card-text text-center m-2"><fa-icon [icon]="faUser"></fa-icon>
              <%=currentUser.cv.email%>
            </h6>
          </div>
          <div class="card-body p-1">
            <div class="card-img-wrapper m-3 text-center">
              <img src="<%=currentUser.cv.photoUrl%>" alt="<%=currentUser.cv.email%>" class="img-fluid img-thumbnail card-img-top user-profile-picture">
            </div>
            <div class="ml-2">
              <h6 class="card-title m-2">
                <strong>First Name: </strong><%=currentUser.cv.firstname%>
              </h6>
              <h6 class="card-title m-2">
                <strong>Last Name: </strong><%=currentUser.cv.lastname%>
              </h6>
              <h6 class="card-title m-2">
                <strong>Contact Email: </strong><%=currentUser.cv.email%>
              </h6>
              <h6 class="card-title m-2">
                <strong>Gender: </strong><%=currentUser.cv.gender%>
              </h6>
              <h6 class="card-title m-2">
                <strong>Birthdate: </strong><%=currentUser.cv.birthdate%>
              </h6>
              <h6 class="card-title m-2">
                <strong>Age: </strong><%=currentUser.cv.age%>
              </h6>
              <h6 *ngIf="currentUser.cv.motto" class="card-title m-2">
                <strong>Motto: </strong><%=currentUser.cv.motto%>
              </h6>
            </div>
          </div>
          <div *ngIf="currentUser.cv.aboutMe" class="card-footer p-1">
            <blockquote class="blockquote ml-4 mr-4">
              <div class="card-text mb-0">"<%=currentUser.cv.aboutMe%>"</div>
            </blockquote>

          </div>
        </div>
    </div>

</div>
